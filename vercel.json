{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/apology", "destination": "/index.html" },
    { "source": "/girlfriend", "destination": "/index.html" },
    { "source": "/surprise", "destination": "/index.html" },
    { "source": "/birthday", "destination": "/index.html" },
    { "source": "/friendship", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
